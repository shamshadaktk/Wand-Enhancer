<Window x:Class="WandEnhancer.View.MainWindow.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WandEnhancer.View.MainWindow"
        xmlns:controls="clr-namespace:WandEnhancer.View.Controls"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance local:MainWindowVm}"
        Title="WandEnhancer"
        Height="510" MaxHeight="510"
        Width="780" MaxWidth="780"
        Opacity="0.97"
        Background="Transparent"
        WindowStyle="None"
        FontFamily="{StaticResource Inter}"
        AllowsTransparency="True">
    <Border CornerRadius="12" Background="{DynamicResource Background}"
            BorderBrush="{DynamicResource Border}"
            BorderThickness="1" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" Direction="-90"
                              RenderingBias="Quality" ShadowDepth="3" Opacity="0.55"/>
        </Border.Effect>

        <Grid>
            <Grid Background="Transparent" VerticalAlignment="Top"
                  MouseLeftButtonDown="OnDragMove" Height="62">
                <Border Height="2" CornerRadius="1" Margin="20 9 20 0" Opacity="0.85"
                        VerticalAlignment="Top" Background="{DynamicResource AccentGradient}"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20 6 0 0">
                    <Border Width="36" Height="36" CornerRadius="10"
                            Background="{DynamicResource AccentGradient}"
                            VerticalAlignment="Center">
                        <Border.Effect>
                            <DropShadowEffect Color="{DynamicResource AccentColor}" BlurRadius="14"
                                              ShadowDepth="0" Opacity="0.45" RenderingBias="Quality"/>
                        </Border.Effect>
                        <Viewbox VerticalAlignment="Center" HorizontalAlignment="Center" Width="22" Height="22">
                            <Path Fill="White" Data="{StaticResource Logo}"/>
                        </Viewbox>
                    </Border>
                    <TextBlock Foreground="{DynamicResource Foreground}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               FontSize="17" Margin="11 0 0 0"
                               Text="WandEnhancer"/>
                    <TextBlock x:Name="VersionLabel" VerticalAlignment="Bottom"
                               Opacity="0.7" FontSize="10" Margin="6 0 0 4"
                               Foreground="{DynamicResource MutedForeground}"
                               Text="v 1.0.0"/>

                    <Border CornerRadius="11" Padding="10 4" Margin="12 0 0 0"
                            VerticalAlignment="Center" Background="{DynamicResource Muted}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AlreadyPatched}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SuccessSoft}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource WarnSoft}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="7" Height="7"
                                     VerticalAlignment="Center" Fill="{DynamicResource SuccessDot}">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource WarnDot}"/>
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard x:Name="WorkingPulse">
                                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                             From="1" To="0.3" Duration="0:0:0.6"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <StopStoryboard BeginStoryboardName="WorkingPulse"/>
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock x:Name="StatusText" Margin="7 0 0 0"
                                       FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"
                                       Foreground="{DynamicResource MutedForeground}"
                                       Text="{DynamicResource mw_status_ready}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AlreadyPatched}" Value="True">
                                                <Setter Property="Text" Value="{DynamicResource mw_status_patched}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource SuccessDot}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                <Setter Property="Text" Value="{DynamicResource mw_status_working}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource WarnDot}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Button Margin="8 0 0 0" Padding="10 4"
                            VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold"
                            Background="{DynamicResource AccentSoft}"
                            Foreground="{DynamicResource AccentBright}"
                            BorderBrush="{DynamicResource AccentVivid}"
                            BorderThickness="1" Cursor="Hand"
                            Command="{Binding ShowUpdateCommand}"
                            ToolTip="{DynamicResource up_popup_title}">
                        <Button.Content>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentBright}"
                                         VerticalAlignment="Center"/>
                                <TextBlock Margin="7 0 0 0" VerticalAlignment="Center"
                                           Text="{DynamicResource mw_update_badge}"/>
                            </StackPanel>
                        </Button.Content>
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <!-- Collapsed by default so offline builds never show the badge. -->
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsUpdateAvailable}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Button.Resources>
                            <CornerRadius x:Key="CornerRadius">11 11 11 11</CornerRadius>
                        </Button.Resources>
                    </Button>

                </StackPanel>

                <StackPanel  HorizontalAlignment="Right" Orientation="Horizontal" Margin="0 6 0 0">
                    <Button
                        Margin="0 0 6 0"
                        Width="28" Height="28" Padding="6"
                        Style="{StaticResource IconButton}"
                        Tag="{StaticResource CogIcon}"
                        Command="{Binding OpenSettingsCommand}"
                        />
                    <Button
                        Margin="0 0 14 0"
                        Tag="{StaticResource CloseIcon}"
                        Width="28" Height="28" Padding="7"
                        HorizontalAlignment="Right"
                        Click="OnClosing"
                        VerticalAlignment="Center">
                        <Button.Resources>
                            <CornerRadius x:Key="CornerRadius">8 8 8 8</CornerRadius>
                        </Button.Resources>
                        <Button.Style>
                            <Style BasedOn="{StaticResource IconButton}" TargetType="Button">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource ErrorSoft}"/>
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="{DynamicResource ErrorDot}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <Border Background="{DynamicResource Border}" Height="1" VerticalAlignment="Bottom"></Border>

            </Grid>
            <Grid Margin="0 62 0 0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                    <RowDefinition Height="56"/>
                </Grid.RowDefinitions>

                <Grid Margin="14 10 14 10" Cursor="Hand" Background="Transparent">
                    <TextBox Style="{StaticResource TitledTextBox}"
                             IsReadOnly="True"
                             Text="{Binding WeModInfo.RootDirectory, Mode=OneWay}"
                             VerticalAlignment="Center">
                    </TextBox>
                    <Grid.InputBindings>
                        <MouseBinding Gesture="LeftClick" Command="{Binding SetFolderPathCommand}" />
                    </Grid.InputBindings>
                </Grid>


                    <Border Grid.Row="1" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                            Margin="14 0 14 10" Padding="0 8 0 8"
                            Background="{DynamicResource Muted}"
                            CornerRadius="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Margin="12 0 8 6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentVivid}"
                                             VerticalAlignment="Center"/>
                                    <TextBlock Margin="8 0 0 0" FontSize="10.5" FontWeight="Bold"
                                               Foreground="{DynamicResource MutedForeground}"
                                               VerticalAlignment="Center"
                                               Text="{DynamicResource mw_activity}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Width="24" Height="24" Padding="5"
                                            Style="{StaticResource IconButton}"
                                            Tag="{StaticResource CopyIcon}"
                                            ToolTip="{DynamicResource mw_copy_logs}"
                                            Command="{Binding CopyLogsCommand}"/>
                                    <Button Width="24" Height="24" Padding="5" Margin="5 0 0 0"
                                            Style="{StaticResource IconButton}"
                                            Tag="{StaticResource ExportIcon}"
                                            ToolTip="{DynamicResource mw_export_logs}"
                                            Command="{Binding ExportLogsCommand}"/>
                                </StackPanel>
                            </Grid>
                            <ListBox Grid.Row="1" ItemsSource="{Binding LogList}" SelectionMode="Single"
                                 BorderBrush="Transparent" BorderThickness="0"
                                 Background="Transparent"
                                 x:Name="LogList"
                                 Padding="8 0"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.CanContentScroll="False">
                            <ListBox.ItemContainerStyle>
                                                    <Style TargetType="ListBoxItem">
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Margin" Value="0 0 0 3"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Row" CornerRadius="6" Padding="10 6"
                                            Background="Transparent"
                                            BorderBrush="Transparent" BorderThickness="1">
                                        <DockPanel LastChildFill="True">
                                            <Ellipse x:Name="LevelDot" DockPanel.Dock="Left"
                                                     Width="7" Height="7" Margin="0 0 9 0"
                                                     VerticalAlignment="Center"
                                                     Fill="{DynamicResource InfoDot}"/>
                                            <TextBox Text="{Binding Message}"
                                                     Cursor="IBeam" FontSize="12.5"
                                                     Foreground="{DynamicResource Foreground}"
                                                     Background="Transparent" TextWrapping="Wrap"
                                                     BorderThickness="0"
                                                     IsReadOnly="True"/>
                                        </DockPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="#10FFFFFF"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource AccentFaint}"/>
                                            <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource AccentSoft}"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding LogType}" Value="Error">
                                            <Setter TargetName="LevelDot" Property="Fill" Value="{DynamicResource ErrorDot}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding LogType}" Value="Info">
                                            <Setter TargetName="LevelDot" Property="Fill" Value="{DynamicResource InfoDot}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding LogType}" Value="Warn">
                                            <Setter TargetName="LevelDot" Property="Fill" Value="{DynamicResource WarnDot}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding LogType}" Value="Success">
                                            <Setter TargetName="LevelDot" Property="Fill" Value="{DynamicResource SuccessDot}"/>
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>

                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                        </Grid>
                    </Border>


                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Grid.Row="2" Margin="14 0 14 12">
                    <Grid>
                        <Grid HorizontalAlignment="Right" >
                            <Grid.Style>
                                <Style TargetType="{x:Type Grid}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPatchEnabled}" Value="False">
                                            <Setter Property="Cursor" Value="No"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Button
                                    IsEnabled="{Binding IsPatchEnabled}"
                                    FontWeight="Bold" FontSize="15" Width="200" Height="38"
                                    Command="{Binding ApplyPatchCommand}"
                                    Content="{DynamicResource mw_patch}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ColoredButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                <Setter Property="Content" Value="{DynamicResource mw_status_working}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                        <Button HorizontalAlignment="Right"
                                Command="{Binding RestoreBackupCommand}"
                                FontWeight="Bold" FontSize="15" Width="200" Height="38"
                                Style="{StaticResource ColoredButton}"
                                IsEnabled="{Binding IsIdle}"
                                Visibility="{Binding CanRestore, Converter={StaticResource ToVisibilityConverter}}"
                                Content="{DynamicResource mw_restore}"/>
                    </Grid>
                </StackPanel>



                <DockPanel Grid.Row="2" Margin="16 0 14 12">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                Cursor="Hand"
                                HorizontalAlignment="Left"
                                MouseDown="OpenSourceClicked"
                                Background="Transparent" Opacity="0.85">
                        <Viewbox VerticalAlignment="Center" Width="24" Height="24">
                            <Path
                                Fill="{DynamicResource MutedForeground}" Data="{StaticResource GitHub}"/>
                        </Viewbox>
                        <Grid>
                            <TextBlock Margin="9 0 0 0"  FontSize="10.5" Foreground="{DynamicResource AccentForeground}">
                                <Hyperlink Foreground="{DynamicResource MutedForeground}"><Run Text="{DynamicResource mw_source_code}"/></Hyperlink>
                                <LineBreak/>
                                <Run Text="{DynamicResource mw_made_by}" Foreground="{DynamicResource MutedForeground}"/>

                                <LineBreak/>
                                <Run Foreground="{DynamicResource MutedForeground}" Text="{DynamicResource mw_star_hint}"/>
                            </TextBlock>
                        </Grid>
                    </StackPanel>
                </DockPanel>
            </Grid>

            <controls:PopupHost x:Name="PopupHost"/>
        </Grid>
    </Border>
</Window>
