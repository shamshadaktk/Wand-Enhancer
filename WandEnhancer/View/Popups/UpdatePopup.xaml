<UserControl x:Class="WandEnhancer.View.Popups.UpdatePopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             MinWidth="470" MaxWidth="470">
    <StackPanel>
        <Border Background="{DynamicResource WarnSoft}" CornerRadius="8" Padding="12 9" Margin="0 0 0 12">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="8" Height="8" Fill="{DynamicResource WarnDot}"
                         VerticalAlignment="Center"/>
                <TextBlock Margin="9 0 0 0" FontSize="12.5" FontWeight="Medium"
                           Foreground="{DynamicResource WarnDot}"
                           VerticalAlignment="Center" TextWrapping="Wrap"
                           Text="{DynamicResource up_warning}"/>
            </StackPanel>
        </Border>

        <Grid Margin="0 0 0 12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Background="{DynamicResource Muted}" CornerRadius="8" Padding="10 8">
                <StackPanel>
                    <TextBlock FontSize="10.5" FontWeight="Bold"
                               Foreground="{DynamicResource MutedForeground}"
                               Text="{DynamicResource up_current_version}"/>
                    <TextBlock x:Name="CurrentVersionValue" FontSize="15" FontWeight="SemiBold"
                               Margin="0 2 0 0" Foreground="{DynamicResource Foreground}"
                               Text="?.?.?"/>
                </StackPanel>
            </Border>
            <Path Grid.Column="1" Width="10" Height="14" Margin="10 0"
                  Stretch="Fill" VerticalAlignment="Center"
                  Data="{StaticResource ChevronRight}" Fill="{DynamicResource AccentBright}"/>
            <Border Grid.Column="2" CornerRadius="8" Padding="10 8"
                    Background="{DynamicResource AccentGradient}">
                <StackPanel>
                    <TextBlock FontSize="10.5" FontWeight="Bold"
                               Foreground="{DynamicResource AccentInk}" Opacity="0.75"
                               Text="{DynamicResource up_latest_version}"/>
                    <TextBlock x:Name="LatestVersionValue" FontSize="15" FontWeight="Bold"
                               Margin="0 2 0 0" Foreground="{DynamicResource AccentInk}"
                               Text="?.?.?"/>
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock Margin="0 0 0 6" FontSize="13" FontWeight="Bold"
                   Foreground="{DynamicResource Foreground}"
                   Text="{DynamicResource up_release_notes}"/>

        <Border Background="{DynamicResource Muted}" CornerRadius="8" Padding="12"
                BorderBrush="{DynamicResource Border}" BorderThickness="1"
                MinHeight="160" MaxHeight="240">
            <ScrollViewer x:Name="NotesScrollViewer"
                          VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Disabled">
                <TextBox x:Name="NotesTextBlock"
                         IsReadOnly="True" TextWrapping="Wrap" FontSize="12.5"
                         Foreground="{DynamicResource Foreground}"
                         Background="Transparent" BorderThickness="0"
                         Cursor="IBeam"
                         Text="Release notes"/>
            </ScrollViewer>
        </Border>

        <Grid Margin="0 14 0 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="ShowMoreButton" Padding="14 0" Height="34" FontSize="13"
                    Content="{DynamicResource up_show_more}"
                    Click="OnShowMoreClick"/>
            <Button Grid.Column="1" Margin="8 0 0 0" Padding="14 0" Height="34" FontSize="13"
                    Style="{StaticResource ColoredButton}"
                    Content="{DynamicResource up_open_release}"
                    Click="OnOpenReleaseClick"/>
        </Grid>
    </StackPanel>
</UserControl>
